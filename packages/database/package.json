{
  "name": "@webhooks-lol/database",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:local:logs": "docker logs --follow webhooks-lol-postgres",
    "db:local:start": "docker start webhooks-lol-postgres || docker run --name webhooks-lol-postgres --detach --publish 5434:5432 --env POSTGRES_DB=webhooks-lol --env POSTGRES_USER=postgres --env POSTGRES_PASSWORD=postgres --volume webhooks-lol-postgres-data:/var/lib/postgresql/data postgres:18",
    "db:local:stop": "docker stop webhooks-lol-postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "typescript": "^5"
  }
}
