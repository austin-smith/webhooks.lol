{
  "name": "webhooks-lol",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 4665",
    "docs:build": "pnpm --filter @webhooks-lol/docs build",
    "docs:dev": "pnpm --filter @webhooks-lol/docs dev",
    "docs:verify": "pnpm --filter @webhooks-lol/docs verify",
    "cli:build": "pnpm --filter whlol build",
    "cli:verify": "pnpm --filter whlol verify",
    "db:generate": "drizzle-kit generate",
    "db:local:logs": "docker logs --follow webhooks-lol-postgres",
    "db:local:start": "docker start webhooks-lol-postgres || docker run --name webhooks-lol-postgres --detach --publish 5434:5432 --env POSTGRES_DB=webhooks-lol --env POSTGRES_USER=postgres --env POSTGRES_PASSWORD=postgres --volume webhooks-lol-postgres-data:/var/lib/postgresql/data postgres:18",
    "db:local:stop": "docker stop webhooks-lol-postgres",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "forwarding:worker": "tsx script/forwarding-worker.ts",
    "test": "vitest run",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "redis:local:logs": "docker logs --follow webhooks-lol-redis",
    "redis:local:start": "docker start webhooks-lol-redis || docker run --name webhooks-lol-redis --detach --publish 6379:6379 --volume webhooks-lol-redis-data:/data redis:8 redis-server --appendonly yes",
    "redis:local:stop": "docker stop webhooks-lol-redis",
    "verify": "pnpm verify:web && pnpm cli:verify && pnpm docs:verify",
    "verify:web": "pnpm typegen && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "better-auth": "^1.6.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "next-themes": "^0.4.6",
    "pg-boss": "^12.18.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.5.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "redis": "^6.0.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.11.0",
    "shiki": "^4.2.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
