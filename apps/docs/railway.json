{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm docs:build",
    "watchPatterns": [
      "/**",
      "!/apps/cli/**",
      "!/apps/pgboss/**",
      "!/apps/web/**"
    ]
  },
  "deploy": {
    "startCommand": "pnpm docs:start",
    "runtime": "V2",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    }
  }
}
