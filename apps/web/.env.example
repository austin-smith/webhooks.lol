# App environment
APP_ENV=local

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:4665

# Docs app URL
NEXT_PUBLIC_DOCS_URL=http://localhost:4666

# Postgres database
DATABASE_URL=postgres://postgres:postgres@localhost:5434/webhooks-lol

# Redis database
REDIS_URL=redis://localhost:6379

# Rate limiting
# Required header used to identify each client for per-client rate limits.
# Set this to a header your trusted proxy controls, such as `x-forwarded-for`.
TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4665

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# GitHub OAuth
GITHUB_CLIENT_ID=change-me
GITHUB_CLIENT_SECRET=change-me

# Email sending
CLOUDFLARE_ACCOUNT_ID=change-me
CLOUDFLARE_EMAIL_API_TOKEN=change-me
EMAIL_FROM_ADDRESS=no-reply@webhooks.lol
