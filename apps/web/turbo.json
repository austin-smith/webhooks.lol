{
  "extends": ["//"],
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["$TURBO_EXTENDS$", "typecheck"],
      "env": [
        "APP_BUILD_AT",
        "APP_BUILD_BRANCH",
        "APP_BUILD_COMMIT_SHA",
        "APP_BUILD_COMMIT_SUBJECT",
        "APP_BUILD_DIRTY",
        "APP_ENV"
      ],
      "outputs": [".next/**", "!.next/cache/**", "!.next/types/**"]
    },
    "dev": {
      "with": [
        "@webhooks-lol/database#watch",
        "@webhooks-lol/webhooks-core#watch",
        "@webhooks-lol/webhooks-server#watch"
      ]
    },
    "typecheck": {
      "dependsOn": ["$TURBO_EXTENDS$", "typegen"]
    },
    "typegen": {
      "dependsOn": ["^build"],
      "outputs": [".next/types/**"]
    }
  }
}
