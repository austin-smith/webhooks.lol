{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm --filter @webhooks-lol/pgboss build",
    "watchPatterns": ["/**", "!/apps/cli/**", "!/apps/docs/**", "!/apps/web/**"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @webhooks-lol/pgboss start",
    "runtime": "V2",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "multiRegionConfig": {
      "us-west2": {
        "numReplicas": 1
      }
    }
  }
}
