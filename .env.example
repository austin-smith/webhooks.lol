# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5434/webhooks-lol

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting
# Optional per-client rate-limit header.
# Use only when your trusted proxy rewrites it, e.g. `x-forwarded-for`.
TRUSTED_CLIENT_IP_HEADER=

# Better Auth
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:4665

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
